# ============================================================================
# Healthcare Analytics Database Configuration
# Copy this file to .env and update with your database credentials
# ============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional: Connection String (alternative to above)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_analytics

# Deployment Options
LOAD_SAMPLE_DATA=yes          # yes/no - Load 1000 sample patients?
RUN_TESTS=yes                 # yes/no - Run validation tests after deployment?

# Performance Settings
ENABLE_PARALLEL=yes           # yes/no - Use parallel loading for large datasets
BATCH_SIZE=1000              # Rows per batch for bulk inserts

# Security Settings
ENABLE_RLS=no                # yes/no - Enable row-level security policies?
AUDIT_QUERIES=no             # yes/no - Log all queries to audit table?

# Advanced Settings (optional)
SCHEMA_NAME=public           # Database schema to use
TIMEZONE=America/New_York    # Timezone for date/time operations
