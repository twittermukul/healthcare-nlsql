# ============================================================================
# Healthcare Analytics NL→SQL API Configuration
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Model Selection (2025)
# GPT-5 Series (Latest):
# - gpt-5: 400K context, 128K output, $1.25 in / $10 out per 1M tokens
# - gpt-5-mini: 400K context, 128K output, $0.30 in / $2.50 out (RECOMMENDED)
# - gpt-5-nano: 400K context, 128K output, $0.10 in / $1.00 out (Fastest)
#
# O-Series Reasoning:
# - o4-mini: 200K context, 100K output, $1.10 in / $4.40 out
# - o3: 200K context, 100K output, $20 in / $80 out
# - o1: 200K context, 100K output, $15 in / $60 out
#
# GPT-4 Series:
# - gpt-4o-mini: 128K context, 16K output, $0.15 in / $0.60 out (Cheapest)
# - gpt-4o: 128K context, 16K output, $2.50 in / $10 out
OPENAI_MODEL=gpt-5-mini

# Model Parameters
OPENAI_TEMPERATURE=0.1

# Max Tokens (Optional - auto-detected per model if not set)
# Leave commented to use model-specific defaults
# OPENAI_MAX_TOKENS=16384

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Application Settings
APP_NAME=Healthcare Analytics NL→SQL API
APP_VERSION=1.0.0
DEBUG=true

# Query Settings
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT_SECONDS=30
ENABLE_QUERY_CACHE=true
CACHE_TTL_SECONDS=300

# Security
ENABLE_QUERY_VALIDATION=true
ALLOWED_TABLES=dim_patient,vw_patients_2025,vw_patient_annual_costs_2025
BLOCKED_KEYWORDS=DROP,DELETE,TRUNCATE,ALTER,CREATE,INSERT,UPDATE
